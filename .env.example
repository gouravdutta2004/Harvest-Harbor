# ============================================================
# Harvest Harbor Root Environment Configuration Template
# ============================================================

# Backend Configuration
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_FILE_SIZE_BYTES=15728640
MAX_DECODED_PIXELS=50000000
# KERAS_HOME: point to backend/.keras so TensorFlow/Keras does not read ~/.keras/keras.json.
# The backend sets this automatically at startup, but setting it here is recommended for
# environments that launch uvicorn without going through the Python app entry point.
KERAS_HOME=./backend/.keras

# Production API Key Store (JSON string mapping user roles to secure secret keys)
# In production (ENVIRONMENT=production), this variable MUST be set with secure random tokens.
# Supported roles: 'farmer', 'agronomist', 'auditor', 'admin'
# Schema: '{"<role>": "<secret_key>"}'
# Example:
# HARVEST_HARBOR_API_KEYS='{"farmer": "sec-farmer-key-9f82a", "agronomist": "sec-agro-key-4a7b1", "auditor": "sec-auditor-key-2c3d8", "admin": "sec-admin-key-7e1f4"}'

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

