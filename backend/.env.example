# ============================================================
# Harvest Harbor Backend Environment Configuration Template
# ============================================================

# Environment: 'development', 'production', or 'testing'
# In 'production', authentication is strictly enforced and will fail closed if keys are missing.
ENVIRONMENT=development

# Keras/TensorFlow home directory.
# Set to backend/.keras so TF does not read ~/.keras/keras.json (fails in sandboxed envs).
# The application sets this automatically in app.py, health_predictor.py, and predictor.py,
# but setting it explicitly here ensures it is correct regardless of launch method.
KERAS_HOME=./backend/.keras

# Production API Key Store (JSON string mapping user roles to secure secret keys)
# In production (ENVIRONMENT=production), this variable MUST be set with secure random tokens.
# Supported roles: 'farmer', 'agronomist', 'auditor', 'admin'
# Schema: '{"<role>": "<secret_key>"}'
# Example:
# HARVEST_HARBOR_API_KEYS='{"farmer": "sec-farmer-key-9f82a", "agronomist": "sec-agro-key-4a7b1", "auditor": "sec-auditor-key-2c3d8", "admin": "sec-admin-key-7e1f4"}'

# Allowed CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Image & Upload Safety Limits
MAX_FILE_SIZE_BYTES=15728640
MAX_DECODED_PIXELS=50000000
MIN_IMAGE_WIDTH=32
MIN_IMAGE_HEIGHT=32
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000

# Generated Asset File Retention Policy (hours)
MAX_GENERATED_FILE_AGE_HOURS=24
